# Supabase connection (used by the React app at build time)
# These are the public URL + publishable key — safe to expose in the client.
# Data is protected by Row Level Security, not by hiding these values.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# AI scraping/OCR for Netlify Functions (server-side only — NOT prefixed REACT_APP_)
# Set one of these in the Netlify dashboard, not in the client bundle.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
